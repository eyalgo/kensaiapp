# The six tools kensaiapp runs on: the install list that pairs with core/tools/doctor.sh.
# `brew bundle` installs them; the doctor checks them. test_doctor.py fails when the two differ.
# Versions are not pinned here: the minimum for each tool lives in the doctor.
tap "cirruslabs/cli"
brew "uv"
brew "git"
brew "podman"
brew "cirruslabs/cli/tart"
brew "gh"
cask "claude-code"
