#!/usr/bin/env bash
# pre-commit — git-native hook shim. Git invokes this before every ordinary
# commit (not a --no-ff merge; git invokes pre-merge-commit for that, and no
# hook is registered there — see core/doctrine/setup/kensaiapp_structure.md
# § Git-native hooks).
#
# Version: 1.5.0 — a record names no machine — record-privacy check, its pre-commit hook, the rule and the skills' pointers
# Version: 1.4.0 — a test reads nothing of the machine it runs on — refused at commit in every repo, an empty home wherever it runs
# Version: 1.3.0 — hooks run on the locked python
# Version: 1.2.0 — restore pre-commit behavior before core-path enforcement
# Version: 1.1.0 — enable provider-neutral unattended execution with Codex
# Version: 1.0.0
#
# Self-locates core from its own path rather than reading a CORE env var or
# `.env`: a human's or Codex's plain `git commit` carries neither, and
# KENSAIAPP_CORE_RESOLVED is a model-context injection from resolve_core.py,
# not a shell variable a git subprocess inherits. Because setup wires
# `core.hooksPath` to "<resolved-core>/githooks", this hook is invoked *from*
# core, so its own directory *is* the resolved core — self-location is exact.
#
# Resolves the committing repo separately: three satellites route their
# core.hooksPath to this host's core/githooks, so the hook runs from this
# core while git commits in theirs. Conflating the two roots would scan this
# repo's tree and pass every satellite commit.
#
# Performs no checking itself: runs three checkers through
# core/tools/locked_python.sh against the committing repo, so each runs on the
# Python that `.python-version` names at the root of the instance holding this
# core — the written-forward checker, then the test-isolation checker (a test
# reads nothing of the machine it runs on), then the record-privacy checker (a
# record names no machine). All three run whatever the others answer, so one
# commit hears every refusal at once; it exits 1 if any refused.
set -euo pipefail

core="$(cd "$(dirname "$0")/.." && pwd)"
repo="$(git rev-parse --show-toplevel)"
status=0
"$core/tools/locked_python.sh" "$core/tools/written_forward.py" --staged --repo "$repo" || status=1
"$core/tools/locked_python.sh" "$core/tools/check_test_isolation.py" --staged --repo "$repo" || status=1
"$core/tools/locked_python.sh" "$core/tools/check_record_privacy.py" --staged --repo "$repo" || status=1
exit "$status"
